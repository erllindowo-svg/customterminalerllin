#!/bin/bash
# Terminal Soviético — bloqueio de sessão no terminal da central.
#
# Em vez da tela do Omarchy, o bloqueio é a própria central de operações
# (workspace 1) com o pedido de senha dentro do painel de terminal, no estilo
# do `[sudo] senha de ...:`. O terminal que estava ali NÃO é tocado: um foot
# `soviet-lock` flutuante é aberto exatamente sobre ele. Se havia algo rodando
# (claude, vim...), continua rodando por baixo, e volta intacto ao desbloquear.
#
# Enquanto bloqueado:
#   * o Hyprland entra no submap `soviet_lock` (vazio: nenhum atalho age);
#   * a janela do pedido de senha tem stay_focused (cliques não roubam o foco);
#   * um supervisor reabre o pedido se a janela sumir.
# Só o sucesso do PAM (share/terminal-soviet/lock/prompt.py) cria o testemunho
# que libera a sessão.
#
# Uso: soviet-lock [lock]   bloqueia (idempotente); sai assim que está seguro
#      soviet-lock status   JSON no formato esperado pelo plugin erllan.soviet-lock
#
# Limite assumido (docs/decisions.md D17): não é um ext-session-lock. Os
# aplicativos continuam rodando por baixo, como em qualquer bloqueio; a diferença
# é que o compositor não os esconde. A proteção é a de atalhos e foco acima.

set -uo pipefail

TS_CONF="${TS_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/terminal-soviet/terminal-soviet.conf}"
# shellcheck source=/dev/null
[[ -r $TS_CONF ]] && source "$TS_CONF"
SELF=$(readlink -f "${BASH_SOURCE[0]}")
SELF_DIR=$(dirname "$SELF")
WS="${HIDDEN_WORKSPACE:-1}"
RT="${XDG_RUNTIME_DIR:-/run/user/$UID}/soviet-lock"
STATE="$RT/estado"          # requested | secure
TOKEN="$RT/liberado"        # criado pelo prompt.py quando o PAM aceita
SUPERVISOR_PID="$RT/supervisor.pid"
SUBMAP=soviet_lock
CLASS=soviet-lock
PROMPT="${SOVIET_LOCK_PROMPT:-${XDG_DATA_HOME:-$HOME/.local/share}/terminal-soviet/lock/prompt.py}"
# Falhas seguidas de abertura do pedido antes de o bloqueio chegar a ficar seguro:
# passando disso, desiste (e avisa) em vez de prender a sessão sem terminal.
MAX_FALHAS_INICIAIS=3

log() { logger -t soviet-lock -- "$*" 2>/dev/null; printf '%s\n' "$*" >&2; }
dsp() { hyprctl dispatch "$1" >/dev/null 2>&1; }

addr_of() {
  hyprctl clients -j 2>/dev/null | jq -r --arg c "$1" '[.[] | select(.class == $c)][0].address // empty'
}

supervisor_vivo() {
  local pid; pid=$(cat "$SUPERVISOR_PID" 2>/dev/null) || return 1
  [[ $pid =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null
}

# "locked" só vale com supervisor vivo: restos de uma sessão anterior não contam.
bloqueado() { [[ -f $STATE ]] && supervisor_vivo; }

cmd_status() {
  local st=idle requested=false secure=false locked=false
  if bloqueado; then
    locked=true; st=$(cat "$STATE")
    [[ $st == secure ]] && secure=true
    requested=true
  fi
  printf '{"locked":%s,"requested":%s,"secure":%s,"engine":"soviet-lock"}\n' "$locked" "$requested" "$secure"
}

cmd_lock() {
  local dep
  for dep in foot hyprctl jq python3 flock; do
    command -v "$dep" >/dev/null || { log "dependência ausente: $dep"; return 1; }
  done
  [[ -r $PROMPT ]] || { log "pedido de senha ausente: $PROMPT"; return 1; }
  mkdir -p -m 700 "$RT"
  if bloqueado; then
    # Já bloqueado (ou bloqueando): aguarda ficar seguro, como o bloqueio do Omarchy.
    wait_secure; return $?
  fi
  rm -f "$STATE" "$TOKEN"
  echo requested > "$STATE"
  setsid -f "$SELF" _supervisor >/dev/null 2>&1 9>&-
  wait_secure
}

wait_secure() {  # até 8 s (a central pode precisar recompor o terminal)
  local i
  for (( i = 0; i < 80; i++ )); do
    [[ $(cat "$STATE" 2>/dev/null) == secure ]] && return 0
    [[ -f $STATE ]] || return 1
    sleep 0.1
  done
  return 1
}

# ------------------------------------------------------------- supervisor
shell_geometry() {  # "x y w h" do painel de terminal da central, ou vazio
  hyprctl clients -j 2>/dev/null | jq -r '[.[] | select(.class == "soviet-ops-shell")][0]
    | select(. != null) | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"'
}

# Põe o pedido de senha exatamente sobre o painel de terminal. É estética: a
# segurança não depende disso, então qualquer falha cai para tela cheia.
posicionar() {  # posicionar <endereço>
  local a=$1 geo x y w h now
  geo=$(shell_geometry)
  if [[ -n $geo ]]; then
    read -r x y w h <<< "$geo"
    dsp "hl.dsp.window.float({ action = \"enable\", window = \"address:$a\" })"
    dsp "hl.dsp.window.move({ x = $x, y = $y, window = \"address:$a\" })"
    dsp "hl.dsp.window.resize({ x = $w, y = $h, relative = false, window = \"address:$a\" })"
    now=$(hyprctl clients -j 2>/dev/null | jq -r --arg a "$a" '.[] | select(.address == $a) | "\(.at[0]) \(.at[1]) \(.size[0]) \(.size[1])"')
    if [[ -n $now ]] && awk -v a="$now" -v b="$x $y $w $h" 'BEGIN {
        split(a, p); split(b, q)
        for (i = 1; i <= 4; i++) { d = p[i] - q[i]; if (d < 0) d = -d; if (d > 6) exit 1 }
        exit 0 }'; then
      dsp "hl.dsp.focus({ window = \"address:$a\" })"
      return 0
    fi
  fi
  log "posicionamento sobre o painel falhou: pedido de senha em tela cheia"
  dsp "hl.dsp.window.fullscreen({ mode = \"fullscreen\", action = \"set\", window = \"address:$a\" })"
  dsp "hl.dsp.focus({ window = \"address:$a\" })"
}

abrir_pedido() {  # abre o foot do pedido e posiciona; define FOOT_PID
  SOVIET_LOCK_TOKEN="$TOKEN" foot --app-id="$CLASS" --title="СТАНЦИЯ // ДОСТУП" \
    --working-directory=/ --override=pad=8x6 \
    python3 -I "$PROMPT" >/dev/null 2>&1 9>&- &
  FOOT_PID=$!
  local a i
  for (( i = 0; i < 50; i++ )); do
    a=$(addr_of "$CLASS"); [[ -n $a ]] && break
    kill -0 "$FOOT_PID" 2>/dev/null || return 1
    sleep 0.1
  done
  [[ -n ${a:-} ]] || return 1
  posicionar "$a"
}

liberar() {
  dsp 'hl.dsp.submap("reset")'
  # Volta ao workspace e à janela de antes, quando ainda existem.
  [[ -n ${PREV_WS:-} ]] && dsp "hl.dsp.focus({ workspace = \"$PREV_WS\" })"
  if [[ -n ${PREV_WIN:-} ]] && hyprctl clients -j 2>/dev/null | jq -e --arg a "$PREV_WIN" 'any(.[]; .address == $a)' >/dev/null; then
    dsp "hl.dsp.focus({ window = \"address:$PREV_WIN\" })"
  fi
  rm -f "$STATE" "$TOKEN" "$SUPERVISOR_PID"
}

supervisor() {
  exec 9>"$RT/supervisor.lock"
  flock -n 9 || exit 0
  echo $$ > "$SUPERVISOR_PID"
  PREV_WS=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // empty')
  PREV_WIN=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')
  FOOT_PID=""
  trap 'liberar; exit 0' TERM INT HUP
  trap '[[ -n ${FOOT_PID:-} ]] && kill "$FOOT_PID" 2>/dev/null' EXIT

  # Garante a central (idempotente; só abre o que falta) e vai para ela.
  if [[ -z $(addr_of soviet-ops-shell) ]] && [[ -x $SELF_DIR/soviet-ops ]]; then
    "$SELF_DIR/soviet-ops" >/dev/null 2>&1 9>&-
  fi
  dsp "hl.dsp.focus({ workspace = \"$WS\" })"
  sleep 0.2

  local falhas=0 seguro=0
  while :; do
    if abrir_pedido; then
      if (( ! seguro )); then
        dsp "hl.dsp.submap(\"$SUBMAP\")"
        echo secure > "$STATE"
        seguro=1
      fi
      falhas=0
    else
      kill "$FOOT_PID" 2>/dev/null
      (( ++falhas ))
      if (( ! seguro && falhas >= MAX_FALHAS_INICIAIS )); then
        log "não consegui abrir o pedido de senha: bloqueio abortado"
        notify-send -u critical "Bloqueio não aplicado" "O terminal de senha não abriu; a sessão segue desbloqueada." 2>/dev/null
        liberar; exit 1
      fi
    fi
    wait "$FOOT_PID" 2>/dev/null
    FOOT_PID=""
    [[ -f $TOKEN ]] && break
    # Janela fechada ou foot morto sem senha: reabre. Pausa curta evita laço quente.
    sleep 0.3
  done
  liberar
  exit 0
}

case "${1:-lock}" in
  lock) cmd_lock ;;
  status) cmd_status ;;
  _supervisor) supervisor ;;
  *) echo "uso: soviet-lock [lock|status]" >&2; exit 2 ;;
esac
