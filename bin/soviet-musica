#!/bin/bash
# Terminal Soviético — Spotify como um segundo scratchpad (atalho KEY_MUSICA).
#
# A janela do Spotify mora no workspace especial "musica" (regra em
# ~/.config/hypr/terminal_soviet.lua) e esta tecla o mostra/esconde, como o
# SUPER+S faz com o scratchpad do Omarchy:
#   * Spotify aberto                  -> alterna special:musica no monitor atual
#   * janela fora de special:musica   -> devolve para lá antes de alternar
#   * Spotify fechado                 -> abre e mostra quando a janela aparecer
# O "Mostrar o app" do player da barra (erllan/spotify-media) alterna o mesmo
# workspace, então os dois mecanismos não brigam.

set -uo pipefail

WS="special:musica"
LOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/soviet-musica.lock"

exec 9>"$LOCK"
flock -n 9 || exit 0   # acionamentos repetidos enquanto o Spotify ainda abre

dsp() { hyprctl dispatch "$1" >/dev/null 2>&1; }

janelas() {
  hyprctl clients -j | jq -r '.[] | select(.class | test("^[Ss]potify$"))
    | "\(.address) \(.workspace.name)"'
}

# Põe no workspace especial as janelas do Spotify que estiverem fora dele.
recolher() {
  local addr ws
  while read -r addr ws; do
    [[ -n $addr && $ws != "$WS" ]] &&
      dsp "hl.dsp.window.move({ workspace = \"$WS\", follow = false, window = \"address:$addr\" })"
  done < <(janelas)
}

visivel() {
  hyprctl monitors -j | jq -e --arg ws "$WS" \
    'any(.[]; .focused and .specialWorkspace.name == $ws)' >/dev/null
}

if [[ -z $(janelas) ]]; then
  pgrep -x spotify >/dev/null || setsid -f uwsm-app -- spotify >/dev/null 2>&1
  for _ in $(seq 40); do          # até 20 s pela janela (o Spotify demora a mapear)
    [[ -n $(janelas) ]] && break
    sleep 0.5
  done
  [[ -n $(janelas) ]] || exit 1
  recolher
  visivel || dsp 'hl.dsp.workspace.toggle_special("musica")'
  exit 0
fi

recolher
dsp 'hl.dsp.workspace.toggle_special("musica")'
