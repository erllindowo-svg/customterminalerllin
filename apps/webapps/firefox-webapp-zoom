#!/bin/bash
# Abre links zoommtg:// / zoomus:// no cliente web do Zoom, no Firefox
url="$1"; web_url="https://app.zoom.us/wc/home"
if [[ $url =~ ^zoom(mtg|us):// ]]; then
  confno=$(echo "$url" | sed -n 's/.*[?&]confno=\([^&]*\).*/\1/p')
  pwd=$(echo "$url" | sed -n 's/.*[?&]pwd=\([^&]*\).*/\1/p')
  [[ -n $confno ]] && web_url="https://app.zoom.us/wc/join/$confno${pwd:+?pwd=$pwd}"
fi
exec firefox --new-window "$web_url"
