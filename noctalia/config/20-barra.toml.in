# Terminal Soviético — barra do Noctalia (substitui a barra do Omarchy)
#
# MODELO: install.sh gera ~/.config/noctalia/20-barra.toml trocando os marcadores BIN,
# BAR_NAME, BAR_END, ACOES_MEMBERS e GAME_* (jogo instalado) conforme config/terminal-soviet.conf,
# e os da grade (BAR_THICKNESS, GAP, CAPSULE_THICKNESS), de lib/ts-lib.sh.
#
# Grade única (px lógicos): barra 26 · item 22 · ícone 16 · espaço 6. Com escala
# fracionária, a barra cresce até virar px físicos inteiros (27 em 4/3; ver
# bar_thickness em lib/ts-lib.sh), senão a borda com a janela pisca. Os plugins
# (tarefas, spotify-media) usam os mesmos marcadores; glifos nativos já são 16.
#
# Uma única barra ("estacao"), no topo por padrão (borda escolhida pelo clique direito
# na zona vazia). Visibilidade controlada por workspace:
#   workspace 1  -> oculta  (a central de operações ocupa a tela)
#   outros       -> visível
# quem faz isso é ~/.local/bin/soviet-bar-sync (serviço soviet-bar-sync.service),
# via `noctalia msg bar-hide|bar-show`. Não ligar auto_hide aqui.
#
# Grupos (esquerda -> direita):
#   CONTEXTO      menu ☭ · workspaces · overview · apps ABERTOS não fixados
#   AÇÕES         inspeção (btop) · grupos · captura · luz noturna · cafeína · perfil de energia · jogo   (centro)
#   UTILIDADES    Spotify · apps FIXADOS · bandeja · notificações · áudio · clima RJ · relógio · control center
#
# Aplicativos estilo Windows (plugin erllan/tarefas): abertos à esquerda, fixados à
# direita (atenuado = fechado). Clique direito num ícone: fixar/desafixar.
#
# Sem separadores: a seção `end` só tem o espaço entre o fim do centro e a borda e
# corta à esquerda o que exceder (a capa do Spotify aparecia "comprimida" por isso).

[bar]
order = ["@BAR_NAME@"]

[bar.@BAR_NAME@]
enabled = true
position = "top"
thickness = @BAR_THICKNESS@
layer = "top"
reserve_space = true
auto_hide = false
smart_auto_hide = false
margin_edge = 0
margin_ends = 0
padding = 6
widget_spacing = @GAP@
capsule_thickness = @CAPSULE_THICKNESS@   # cápsulas com a altura de um item
background_opacity = 1.0
border = "outline"
border_width = 1.0
radius = 0
concave_edge_corners = false
shadow = false
contact_shadow = false
hover_highlight = true
font_scale = 0.90
font_weight = 500
color = "on_surface"
icon_color = "secondary"

# Na vertical, bin/soviet-bar-pos sobrepõe start/center (ações no fim da start):
# mantenha as listas em sincronia.
start   = ["alca", "menu", "workspaces", "overview", "abertos"]
center  = ["group:acoes"]
end     = @BAR_END@

# Ações: moldura fina, sem preenchimento chamativo. O que é do Omarchy (captura,
# hyprsunset, idle) chama o Omarchy (ver 00-coexistencia-omarchy.toml).
[[bar.@BAR_NAME@.capsule_group]]
id = "acoes"
members = @ACOES_MEMBERS@
fill = "surface_variant"
border = "outline"
radius = 0
padding = @GAP@
widget_spacing = @GAP@

# Clique direito na zona vazia: posição da barra (mini-tela com arrasto; plugin
# erllan/barra). A borda escolhida vai para 90-posicao-barra.toml (soviet-bar-pos),
# que vence o `position` acima. O control center continua no ícone dele.
[bar.@BAR_NAME@.dead_zone.actions]
right = "panel-toggle erllan/barra:posicao"

# ---------------------------------------------------------------- CONTEXTO

# Alça "⠿" (grip-vertical): abre o mesmo painel de posição do clique direito na
# zona vazia. A barra não recebe arrasto no 5.0.1 (só painéis têm dragSource/
# dropZone; ui.graph.onPointerMove não diz se há botão pressionado), então
# "arrastar a barra" vira: clicar na alça e arrastar a barra na mini-tela do painel.
[widget.alca]
type = "custom_button"
glyph = "grip-vertical"
label = ""
tooltip = "Posição da barra: arraste na mini-tela  (também: clique direito na zona vazia)"
[widget.alca.actions]
left = "panel-toggle erllan/barra:posicao"
middle = "none"

[widget.menu]
type = "custom_button"
glyph = "star-filled"       # estrela (☭ não existe na fonte de ícones Tabler)
label = ""
tooltip = "Menu Omarchy@AT_MENU@  (dir.: launcher do Noctalia)"
icon_color = "primary"
[widget.menu.actions]
left = "exec omarchy-menu toggle"
right = "panel-toggle launcher"
middle = "none"

[widget.workspaces]
type = "workspaces"
style = "regular"
show_labels = true
label_source = "id"
max_label_chars = 2
labels_only_when_occupied = false
hide_when_empty = false
pill_scale = 0.8
active_pill_size = 1.6
inactive_pill_size = 1.0
focused_color = "primary"
occupied_color = "secondary"
empty_color = "outline"
urgent_color = "error"
capsule_radius = 0

# Overview de workspaces (plugin moorgrove.overview do shell Omarchy), que antes
# tinha botão na barra antiga.
[widget.overview]
type = "custom_button"
glyph = "layout-grid"
tooltip = "Overview dos workspaces"
[widget.overview.actions]
left = "exec omarchy-shell shell toggle moorgrove.overview '{}'"
middle = "none"

# Apps abertos não fixados (o taskbar nativo do 5.0.1 não exclui o WS da central).
# Fixados: [widget.fixados], na seção da direita. Mesmo plugin, um só socat.
[widget.abertos]
type = "erllan/tarefas:abertos"

[widget.fixados]
type = "erllan/tarefas:fixados"

[widget.active_window]
type = "active_window"
icon_size = 12.0
max_length = 150.0
min_length = 0.0
title_scroll = "none"
color = "on_surface_variant"

# ---------------------------------------------------------------- CENTRO

[widget.clock]
type = "clock"
format = "{:%H:%M}"
color = "primary"
font_weight = 700
[widget.clock.actions]
left = "panel-toggle control-center calendar"

[widget.weather]
type = "weather"
show_condition = false
show_temperature = true
max_length = 130
color = "on_surface"
[widget.weather.actions]
left = "panel-toggle control-center weather"

# ---------------------------------------------------------------- AÇÕES
# Sem sensores na barra (CPU/RAM/GPU/NET): o btop da inspeção mostra tudo isso.

# Mesmo mecanismo do atalho SUPER+M: ~/.local/bin/soviet-inspect (abre/fecha).
[widget.inspecao]
type = "custom_button"
glyph = "activity-heartbeat"
tooltip = "Inspeção: btop flutuante — @KEY_INSPECT@"
icon_color = "primary"
[widget.inspecao.actions]
left = "exec @BIN@/soviet-inspect"
middle = "none"

# Grupos: apps instalados por propósito (painel do plugin erllan/grupos;
# classificação inicial: soviet-grupos classificar).
[widget.grupos]
type = "custom_button"
glyph = "category"
tooltip = "Grupos de apps"
[widget.grupos.actions]
left = "panel-toggle erllan/grupos:painel"
middle = "none"

# Captura do Omarchy: esq. = captura (smart: região/janela), dir. = gravação de tela
# (a mesma tecla para; omarchy-capture-screenrecording alterna).
[widget.captura]
type = "custom_button"
glyph = "screenshot"
tooltip = "Captura de tela@AT_CAPTURA@  (dir.: gravar/parar gravação@AT_GRAVAR@)"
[widget.captura.actions]
left = "exec omarchy-capture-screenshot"
right = "exec omarchy-capture-screenrecording"
middle = "none"

# Luz noturna = hyprsunset do Omarchy (a do Noctalia está desligada).
[widget.luz_noturna]
type = "custom_button"
glyph = "moon"
tooltip = "Luz noturna (liga/desliga)@AT_NOTURNA@"
[widget.luz_noturna.actions]
left = "exec omarchy-toggle-nightlight"
middle = "none"

# Cafeína = "stay awake" do idle do shell Omarchy (sem tela de descanso nem bloqueio).
[widget.cafeina]
type = "custom_button"
glyph = "coffee"
tooltip = "Cafeína: manter acordado (liga/desliga)@AT_CAFEINA@"
[widget.cafeina.actions]
left = "exec omarchy-toggle-idle"
middle = "none"

# Perfil de energia (power-profiles-daemon via D-Bus): esq. avança, dir. volta.
[widget.energia]
type = "power_profile"

# Jogo (GAME_DESKTOP): abre pelo .desktop; omitido se não estiver instalado.
[widget.jogo]
type = "custom_button"
glyph = "device-gamepad-2"
custom_image = "@GAME_ICON@"
custom_image_colorize = false
tooltip = "@GAME_NAME@"
[widget.jogo.actions]
left = "exec uwsm-app -- @GAME_DESKTOP@.desktop"
middle = "none"

# ---------------------------------------------------------------- UTILIDADES

[widget.tray]
type = "tray"

# O daemon de notificações é o do shell Omarchy (ver 00-coexistencia-omarchy.toml).
[widget.notificacoes]
type = "custom_button"
glyph = "bell"
tooltip = "Notificações: histórico@AT_NOTIF@  (dir.: não perturbe@AT_SILENCIO@)"
[widget.notificacoes.actions]
left = "exec omarchy-shell notifications showHistory"
right = "exec omarchy-toggle-notification-silencing"
middle = "exec omarchy-shell notifications dismissAll"

# Áudio (plugin local erllan/audio): glifo fone × alto-falante + volume.
# Esq. = popup (volume, mudo, saídas) · dir. = alterna fone ↔ alto-falante ·
# meio = mudo · rolagem = ±5 %. Os gestos são do plugin (sem actions aqui).
[widget.audio]
type = "erllan/audio:bar"

# Player (fork local de azokyen/spotify-media): a barra é o player. Última faixa
# sempre visível, play abre o Spotify oculto, clique na capa/título = painel com
# progresso e busca. Substitui o widget "media".
[widget.spotify]
type = "erllan/spotify-media:bar"

[widget.control-center]
type = "control-center"
