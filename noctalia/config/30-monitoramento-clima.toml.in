# Terminal Soviético — monitoramento (desligado) e clima

# Sysmon do Noctalia desligado: a barra não tem mais sensores (o btop da inspeção,
# SUPER+M, mostra CPU/RAM/GPU/rede). Efeito colateral: a aba "System" do control
# center some. Para religar, enabled = true (com os limiares de cpu_usage_* etc.).
[system.monitor]
enabled = false

# Localização fixa — sem geolocalização por IP.
[location]
auto_locate = false
address = "@WEATHER_ADDRESS@"   # config/terminal-soviet.conf: WEATHER_ADDRESS

# Serviço nativo (Open-Meteo). Previsão: control center, aba Weather
# (clique no widget de clima).
[weather]
enabled = true
unit = "metric"
refresh_minutes = 30
effects = false
